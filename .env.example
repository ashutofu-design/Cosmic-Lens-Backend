# ─────────────────────────────────────────────────────────────────────────────
# Cosmic Lens — environment template.
# Copy to .env (repo root) and artifacts/api-server/.env. Never commit real values.
#
# In production (PROD=1) the backend refuses to boot unless every variable in
# the "REQUIRED IN PRODUCTION" block below is set — see startup_security.py.
# ─────────────────────────────────────────────────────────────────────────────

# Local infrastructure (Docker Compose at repo root)
POSTGRES_DB=cosmiclens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend (artifacts/api-server) — point to local Postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cosmiclens


# ── REQUIRED IN PRODUCTION ───────────────────────────────────────────────────
PROD=1

# Database — must not be SQLite in production, must not be publicly reachable.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/cosmiclens

# Shared rate-limit storage. Without this each gunicorn worker keeps its own
# counters and the effective limit is multiplied by the worker count.
REDIS_URL=redis://127.0.0.1:6379/0

# Admin panel. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# ADMIN_SECRET / SESSION_SECRET: >= 32 chars, high entropy, no placeholder words.
# ADMIN_LOGIN_PASS: >= 12 chars. ADMIN_LOGIN_MPIN: >= 6 digits.
ADMIN_SECRET=
SESSION_SECRET=
ADMIN_LOGIN_USER=
ADMIN_LOGIN_PASS=
ADMIN_LOGIN_MPIN=
ADMIN_ENROLL_CODE=
ADMIN_MAX_DEVICES=2

# Razorpay. Webhook signature verification is mandatory — a missing secret
# makes every webhook fail closed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=https://admin.coosmic.icu,https://coosmic.icu,https://www.coosmic.icu


# ── CLIENT ATTESTATION (optional, enforced when set to 1) ────────────────────
# Turn on only after the Play Store build ships the integrity SDK, otherwise
# every protected request from existing installs returns 403.
PLAY_INTEGRITY_REQUIRED=0
PLAY_INTEGRITY_PACKAGE_NAME=com.cosmiclens.app
# Paste the service account JSON, or point at a file on disk.
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
# PLAY_INTEGRITY_CREDENTIALS_PATH=/etc/cosmiclens/play-integrity.json

APP_CHECK_REQUIRED=0
FIREBASE_PROJECT_NUMBER=

# Extra path prefixes to exclude from attestation (comma separated).
# ATTESTATION_EXEMPT_PATHS=


# ── DEV-ONLY SWITCHES ────────────────────────────────────────────────────────
# All of these are ignored when PROD=1, and production startup aborts if any
# of them is enabled. They exist so local/staging can exercise paid flows.
# ADMIN_NO_AUTH=1
# ADMIN_SECURITY_RELAXED=1
# ADMIN_ALLOW_ALL_DEVICES=1
# DEV_PAYMENT_BYPASS=1
# COUPLE_REPORT_PAYMENT_BYPASS=1
# NUMEROLOGY_REPORT_PAYMENT_BYPASS=1
# PALMISTRY_PAYMENT_BYPASS=1
# FACE_READING_PAYMENT_BYPASS=1
# BIRTH_TIME_RECTIFICATION_PAYMENT_BYPASS=1
# BUSINESS_VASTU_PAYMENT_BYPASS=1
# CAREER_PAYMENT_BYPASS=1
# ASK_V1_PAYMENT_BYPASS=1
# ASK_V3_PAYMENT_BYPASS=1
# ROOM_UPLOAD_PAYMENT_BYPASS=1
# ASK_QUOTA_BYPASS=1
# LOVE_REALITY_PRO_FREE=1
# ASTROVASTU_DEV_GRANT_ENABLED=1
# HEALTH_STATIC_BYPASS=1
