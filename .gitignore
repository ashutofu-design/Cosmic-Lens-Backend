# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
dist-web/
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules
.venv/
venv/
artifacts/api-server/venv/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
.canvas/
.agents/
.upm/

# Replit chat attachments (screenshots / images uploaded in chat)
attached_assets/

# Local protected-file snapshots (see scripts/snapshot-protected.ps1)
backups/snapshots/*
!backups/snapshots/README.md

# Secrets — never commit (use .env.example as template)
.env
.env.*
!.env.example
artifacts/api-server/.env
artifacts/api-server/.env.txt
artifacts/api-server/data/palm_scans/
artifacts/admin-web/.env
artifacts/cosmic-lens-mobile/.env
artifacts/cosmic-lens-mobile/_keystore_extract/
artifacts/cosmic-lens-mobile/upload-keystore.jks
artifacts/cosmic-lens-mobile/credentials.json
**/*keystore-credentials*
numerology agent/.env

# Signing material / service accounts — never commit
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.p8
**/credentials.json
**/service-account*.json
**/serviceAccount*.json
**/*-firebase-adminsdk-*.json

# Release source maps must not ship or be committed
**/*.map
artifacts/cosmic-lens-mobile/dist/
artifacts/cosmic-lens-mobile/android/app/build/
