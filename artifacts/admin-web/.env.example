# ── Local dev (pnpm dev) — recommended ─────────────────────────────
# Vite proxies /api → your VPS Flask API
VITE_API_PROXY_TARGET=http://187.127.174.55:8080

# Must match ADMIN_SECRET in artifacts/api-server/.env on the server
VITE_ADMIN_SECRET=your-admin-secret-here

# ── Static build (deploy-admin-web-vps.ps1) — REQUIRED for dist/ ──
# Without this, Users / Gmail / Ask tabs load empty (no API connection).
# VITE_API_BASE=http://187.127.174.55:8080
