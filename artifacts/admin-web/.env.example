# ── Local dev (pnpm dev) — recommended ─────────────────────────────
# Local dev (recommended): http://127.0.0.1:8080 + scripts/start-admin-local.ps1
# VPS via SSH tunnel: http://127.0.0.1:18080 (ssh -N -L 18080:127.0.0.1:8080 root@VPS)
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Local dev with ADMIN_NO_AUTH=1 on API: use any placeholder (e.g. local-dev).
# VPS / static build: must match ADMIN_SECRET on the server.
VITE_ADMIN_SECRET=local-dev

# ── Static build (deploy-admin-web-vps.ps1) — REQUIRED for dist/ ──
# Without this, Users / Gmail / Ask tabs load empty (no API connection).
# VITE_API_BASE=https://api.cosmiclens.app
