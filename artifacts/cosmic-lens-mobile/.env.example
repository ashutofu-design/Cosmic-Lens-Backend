# App API (alag subdomain — admin se alag)
#   EXPO_PUBLIC_API_URL=https://api.coosmic.icu
#
# Phone direct IP (fallback / local only):
#   EXPO_PUBLIC_API_URL=http://187.127.174.55:8080
EXPO_PUBLIC_API_URL=https://api.coosmic.icu
EXPO_PUBLIC_ALLOW_HTTP_API=1

# Firebase — required for Google login (see eas.json / Firebase console).
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=